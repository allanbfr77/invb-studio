# Configuração da equipe do INVB Studio.
# Quem configura preenche uma vez, salva como "equipe.env" nesta mesma pasta e repassa o arquivo
# aos colegas por um canal privado. NÃO envie o equipe.env para o GitHub: ele guarda chaves.

# Senha para abrir o app neste computador (mínimo 10 caracteres).
INVB_PASSWORD=

# Transcrição: Groq tem camada gratuita. Crie a chave em https://console.groq.com/keys
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
TRANSCRIBE_LANGUAGE=pt

# Login do Google, usado para importar arquivos privados do Drive e para enviar os cortes prontos.
# É o "ID do cliente" criado no Google Cloud (passo a passo no README).
GOOGLE_CLIENT_ID=

# Pasta compartilhada do Drive onde os cortes ficam para a equipe editar.
# É o trecho final do link da pasta: https://drive.google.com/drive/folders/<ESTE_ID>
DRIVE_CUTS_FOLDER_ID=

# Dias que a pregação baixada fica no computador sem uso antes de ser apagada (o link continua salvo).
KEEP_ORIGINAL_DAYS=7

# Tamanho máximo de um vídeo enviado ou importado do Drive, em GB (padrão 4). Gravação bruta de culto
# costuma passar disso; aumente se aparecer "Arquivo grande demais".
MAX_UPLOAD_GB=20

# Qualidade do vídeo baixado do YouTube: 1080 (padrão, mais nítido) ou 720 (download bem mais rápido).
# YT_MAX_HEIGHT=720

# Editor avançado: busca de efeitos sonoros na aba Sons. Sem a chave, só a aba Sons fica sem busca.
# Gere em https://freesound.org/apiv2/apply e copie o "Client secret/Api key".
FREESOUND_API_KEY=

# "Compartilhar" um corte por link na internet (abre mesmo com o computador desligado). Sem a chave, o link só
# abre enquanto o Studio está aberto. Pegue em: Vercel → Storage → nv-cortes → aba .env.local → BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Editor do corte, gaveta Apoio: fotos e vídeos grátis do Pexels para ilustrar a frase. Crie a chave em
# https://www.pexels.com/api/ (grátis). Sem ela, só a gaveta Apoio fica sem busca.
PEXELS_API_KEY=
