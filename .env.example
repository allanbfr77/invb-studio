# Copie para .env (local) ou configure como variáveis de ambiente no servidor.
PORT=8080
# OBRIGATÓRIO em servidor (mín. 10 caracteres). Troque aqui para trocar a senha.
INVB_PASSWORD=
# Onde ficam arquivos e resultados (monte um disco/volume persistente aqui)
DATA_DIR=/data

# IA na nuvem (compatível com a API da OpenAI). Hoje só a TRANSCRIÇÃO usa IA.
OPENAI_API_KEY=
TRANSCRIBE_PROVIDER=openai
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Análise com LLM (emoções, capítulos e cortes com IA) — SEM USO por enquanto. Para reativar: ANALYSIS_LLM=1
# ANALYSIS_LLM=1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_LANGUAGE=auto

# Atrás de proxy/HTTPS (Render, Railway, Fly, Nginx...)
TRUST_PROXY=1
COOKIE_SECURE=1
MAX_UPLOAD_GB=2
# Fica salvo só o link: o vídeo baixado do YouTube/Drive sai do computador depois de tantos dias sem uso
# (a transcrição e os cortes ficam). Padrão 7. Use um número negativo para nunca apagar.
# Atenção: 0 apaga o vídeo na próxima limpeza (ao iniciar o app e a cada 6 horas), mesmo recém-baixado.
# KEEP_ORIGINAL_DAYS=7

# --- Groq (Whisper na nuvem, camada gratuita), reaproveitado do projeto Transcritor ---
# TRANSCRIBE_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Google Drive: login do Google para importar arquivos privados e para enviar os cortes prontos ---
# GOOGLE_CLIENT_ID=   (adicione a origem do app às "Origens JavaScript autorizadas" no Google Cloud)

# Pasta compartilhada onde os cortes prontos ficam para a equipe editar. É o trecho final do link da pasta:
# https://drive.google.com/drive/folders/<ESTE_ID>. Com ela e o GOOGLE_CLIENT_ID, aparece o botão "Enviar para o Drive".
# DRIVE_CUTS_FOLDER_ID=

# Opcional, só para rodar na sua máquina com modelo local: TRANSCRIBE_PROVIDER=local (usa worker/transcribe.py)
