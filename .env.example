# Referência de todas as opções. Na equipe, a configuração vem do install/equipe.env (copiado para .env pelo
# arquivo de início) e as chaves pessoais de IA ficam em install/pessoal.env. Não edite o .env à mão quando houver equipe.env.

# Porta do app no computador (http://127.0.0.1:4321). Se mudar, atualize a origem autorizada no Google Cloud.
PORT=4321
# Senha para abrir o app (mínimo 10 caracteres).
INVB_PASSWORD=
# Onde ficam pregações, transcrições e cortes. Padrão: pasta data/ dentro do projeto.
# DATA_DIR=

# Transcrição: groq (camada gratuita), openai ou local (Whisper neste computador, via worker/transcribe.py).
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=pt

# Recursos de IA (cortes, texto do corte, capítulos e emoções): Claude ou OpenAI, a que tiver chave.
# As chaves de IA ficam em install/pessoal.env (veja install/pessoal.env.example), não aqui.
# Quem usa a chave da OpenAI só para transcrever não ganha IA sozinho: para ligar, AI_PROVIDER=openai.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Login do Google, para importar arquivos privados e enviar os cortes prontos.
# Adicione http://127.0.0.1:4321 às "Origens JavaScript autorizadas" no Google Cloud.
GOOGLE_CLIENT_ID=
# Pasta compartilhada onde os cortes prontos ficam para a equipe editar. É o trecho final do link da pasta:
# https://drive.google.com/drive/folders/<ESTE_ID>. Com ela e o GOOGLE_CLIENT_ID, aparece o botão "Enviar ao Drive".
DRIVE_CUTS_FOLDER_ID=

# Tamanho máximo de um vídeo enviado ou importado do Drive, em GB (padrão 4).
MAX_UPLOAD_GB=20
# Fica salvo só o link: o vídeo baixado do YouTube/Drive sai do computador depois de tantos dias sem uso
# (a transcrição e os cortes ficam). Padrão 7. Use um número negativo para nunca apagar.
# Atenção: 0 apaga o vídeo na próxima limpeza (ao iniciar o app e a cada 6 horas), mesmo recém-baixado.
# KEEP_ORIGINAL_DAYS=7
# Qualidade do vídeo baixado do YouTube: 1080 (padrão) ou 720 (download mais rápido).
# YT_MAX_HEIGHT=720
